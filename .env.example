# Stack Builder Environment Variables

# Anthropic API Key (required for AI-powered prompt interpretation)
# Get your API key from: https://console.anthropic.com/
# Without this, the app will use basic pattern matching instead
ANTHROPIC_API_KEY=your_api_key_here

# Optional: Customize server ports
# PORT=3000
# MIN_PREVIEW_PORT=4000
# MAX_PREVIEW_PORT=4100

# Optional: Node environment
# NODE_ENV=development
